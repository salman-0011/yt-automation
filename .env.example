# Copy to .env and fill in ONLY the keys you have. Never commit .env.
# No key = the supervisor uses your script.md, and voice must come from
# voice/*.mp3 you recorded (audio backend "existing"). App still works.
GEMINI_API_KEY=
ELEVENLABS_API_KEY=
# Optional overrides:
# VIDEO_ENCODER=auto
# FACTORY_HOST=127.0.0.1
# FACTORY_PORT=8000
# GEMINI_CLI=gemini
# ANTIGRAVITY_CLI=antigravity
# GEMINI_MODEL=gemini-2.5-flash
# AUTO_VIDEO_BACKEND=auto        # auto | code | motion-canvas | manim | flow-manual
# AUTO_AUDIO_BACKEND=auto        # auto | gemini-tts | kokoro | piper | existing
# SUPERVISOR_BACKEND=auto        # auto | gemini-api | gemini-cli | antigravity | none
